# --- Obligatoire ---
DATABASE_URL=postgresql://ba:ba@localhost:5432/business_architect
# 32 octets en base64 (openssl rand -base64 32) : chiffre les identifiants des connecteurs
APP_ENCRYPTION_KEY=
# URL publique de l'application (vérification d'origine des requêtes mutantes)
APP_URL=http://localhost:3100

# --- IA (optionnel : sans clé, les agents génératifs tournent en mode heuristique, signalé dans l'UI) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# --- Recherche Web (optionnel, payant selon fournisseur) ---
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# --- Limites par défaut (EUR) du budget d'exploitation IA ---
DEFAULT_WORKSPACE_MONTHLY_AI_BUDGET_EUR=20
DEFAULT_PROJECT_AI_BUDGET_EUR=5

# --- Sandbox ---
SANDBOX_DIR=./sandbox-runs
