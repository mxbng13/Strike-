# ───────── Base ─────────
DATABASE_URL=postgres://entour:entour@localhost:5432/entour
# Secret utilisé pour signer les jetons (vérification e-mail, etc.). 32+ caractères aléatoires.
AUTH_SECRET=change-me-with-a-long-random-string
APP_URL=http://localhost:3000

# ───────── Paiements (Stripe Connect) ─────────
# Sans STRIPE_SECRET_KEY, l'application utilise le fournisseur « simulation » :
# aucun argent réel, chaque opération est marquée « SIMULATION » dans l'interface.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ───────── IA (assistant de rédaction) ─────────
# Sans clé, un assistant local à base de règles est utilisé (catégorisation + correction simple).
ANTHROPIC_API_KEY=

# ───────── E-mails (Resend) ─────────
# Sans clé, les e-mails sont écrits dans la console du serveur (développement uniquement).
RESEND_API_KEY=
EMAIL_FROM="ENTOUR <bonjour@entour.fr>"

# ───────── SMS (vérification du téléphone) ─────────
# Sans fournisseur configuré, le code est écrit dans la console du serveur (développement uniquement).
SMS_PROVIDER=console

# ───────── Stockage des fichiers ─────────
# local (dossier ./uploads) ou s3 (compatible S3 : AWS, Scaleway, OVH, R2…)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ───────── Carte ─────────
# Style MapLibre. Par défaut : OpenFreeMap (gratuit, sans clé).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
